@{
    ViewData["Title"] = "Buscar ID de Veterinario";
}

<h2>@ViewData["Title"]</h2>

@using (Html.BeginForm("MostrarGrafica", "GraficaP", FormMethod.Post))
{
    <div class="form-group">
        <label for="idVeterinario">ID del veterinario:</label>
        <input style="width:200px"type="text" name="idVeterinario" id="idVeterinario" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Buscar</button>
}